# Data: DVC stores it, and git keeps only the .dvc pointer files.
data/*
!data/*.dvc
!data/.gitignore
*.csv
# Result tables are committed so the README can cite them.
!results/**/*.csv

# Tracking stores, models, build outputs
mlflow.db
mlruns/
mlartifacts/
# Scratch folder app/app.ipynb uses when it rebuilds the production model locally
rebuild/
results/models/
serving/model/
catboost_info/
dist/
*.pkl
*.joblib

# Logs
*.log

# Environments and caches
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.Rhistory
.RData

# Course materials
assignment.md

# Secrets and OS files (DVC keeps remote credentials in .dvc/config.local, which dvc init ignores)
.env
*service-account*.json
client_secret*.json
.DS_Store
